      "source": [
        "#necsessary libraries import kraingy\n",
        "import sklearn\n",
        "import numpy as np\n",
        "#tfidf will use to convert text into numbers\n",
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "#cosine_similatirt -> apk questions ki similarity\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "#file sy questions answers k patterns /expressions inko import krna chahty hai\n",
        "import re"
      ],
      "metadata": {
        "id": "yrbripR3paHK"
      },
      "execution_count": 7,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "#dataset ko load krna\n",
        "#hmara dataset wo text file hai -> questions/answers hain\n",
        "with open('/content/drive/MyDrive/NIAI-AI ML/October/Week 7/Day 25/chatbot_general_qa_500.txt', encoding = \"utf-8-sig\")as file:\n",
        "  text = file.read()\n",
        "\n",
        "print(text[:500])\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "4XmGdC9xuO_d",
        "outputId": "eddec08d-591e-4302-b8c7-b1fe1fedba75"
      },
      "execution_count": 8,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "GENERAL QUESTIONS AND ANSWERS (500 ITEMS)\n",
            "Purpose: Simple knowledge data for teaching non-technical students how to build a chatbot.\n",
            "Format: Each item has a number, one Question (Q) and one Answer (A).\n",
            "All answers are stable, well-established facts.\n",
            "\n",
            "==================================================\n",
            "SECTION 1: PAKISTAN\n",
            "==================================================\n",
            "\n",
            "1.\n",
            "Q: What is the capital of Pakistan?\n",
            "A: Islamabad.\n",
            "\n",
            "2.\n",
            "Q: Who is known as the founder of Pakistan?\n",
            "A: Muhammad Ali Jinnah.\n",
            "\n",
            "\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "#questions and answers ko extract krna hai.\n",
        "pattern = r\"(?im)^\\s*Q:\\s*(.*?)\\s*\\r?\\n\\s*A:\\s*(.*?)\\s*$\"\n",
        "#questions and answers ki pairs bnany hain(relevant question usko attach krna hai relevant answer )\n",
        "\n",
        "pairs = re.findall(pattern, text)\n",
        "\n",
        "#all questions aik list mai ajain\n",
        "questions = [q.strip() for q, a in pairs]\n",
        "#all answers aik list mai ajain\n",
        "answers = [a.strip() for q,a in pairs]\n",
        "\n",
        "#total questions and answers kitny hain?\n",
        "print(\"Total Questions and Answer:s\",len(questions))\n",
        "print()\n",
        "\n",
        "for i in range(min(5, len(questions))):\n",
        "  print(\"Q:\", questions[i])\n",
        "  print(\"A:\", answers[i])\n",
        "  print()\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
