    {
      "cell_type": "code",
      "source": [
        "from IPython.core.interactiveshell import no_op\n",
        "#now tfidf model bnaingy\n",
        "vectorizer = TfidfVectorizer(lowercase = True, stop_words = \"english\",ngram_range=(1,2))\n",
        "\n",
        "questions_vector = vectorizer.fit_transform(questions)\n",
        "\n",
        "print(\"TFIDF is ready to use\")\n",
        "print(\"Questions Vector Shape\", questions_vector.shape)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "-sGFy3YZuhJa",
        "outputId": "d9d6cadb-8e7f-4034-a044-57f3877f68eb"
      },
      "execution_count": 10,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "TFIDF is ready to use\n",
            "Questions Vector Shape (500, 2029)\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def chatbot(user_question):\n",
        "\n",
        "  #user k given question ko numbers mai cn=onvert krna hai\n",
        "\n",
        "  user_vector = vectorizer.transform([user_question])\n",
        "\n",
        "  #user k question or dataset k question ki similarity dhkeni hai\n",
        "\n",
        "  score = cosine_similarity(user_vector, questions_vector).flatten()\n",
        "\n",
        "  #best index wali value nikalni hai-> hmary chatbor ko similar question find krny mai asani ho\n",
        "\n",
        "  best_index = score.argmax()\n",
        "\n",
        "  #best matching question ka best matching answer nikalna hai\n",
        "  #best score ki base pr answer nikalna hai\n",
        "\n",
        "  best_score = score[best_index]\n",
        "\n",
        "  if score<0.2:\n",
        "    return \"Sorry I do not know the relevant answer!\"\n",
        "\n",
        "  return answers[best_index]\n"
      ],
