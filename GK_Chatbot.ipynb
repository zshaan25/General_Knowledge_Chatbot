      "cell_type": "code",
      "source": [
        "!pip install -q gradio\n",
        "\n",
        "import gradio as gr\n",
        "\n",
        "def chatbot(user_question):\n",
        "    user_vector = vectorizer.transform([user_question])\n",
        "    score = cosine_similarity(user_vector, questions_vector).flatten()\n",
        "    best_index = score.argmax()\n",
        "    best_score = score[best_index]\n",
        "\n",
        "    if best_score < 0.2:\n",
        "        return \"Sorry, I do not know the answer to that.\"\n",
        "\n",
        "    return answers[best_index]\n",
        "\n",
        "def ask(user_question):\n",
        "    user_question = (user_question or \"\").strip()\n",
        "    if not user_question:\n",
        "        return \"Please type a question.\"\n",
        "    return chatbot(user_question)\n",
        "\n",
        "demo = gr.Interface(\n",
        "    fn=ask,\n",
        "    inputs=gr.Textbox(label=\"Your question\", placeholder=\"e.g. capital of Pakistan\"),\n",
        "    outputs=gr.Textbox(label=\"Answer\"),\n",
        "    title=\"Ilm - General Knowledge Chatbot\",\n",
        "    api_name=\"ask\",\n",
        "    flagging_mode=\"never\",\n",
        ")\n",
        "\n",
        "demo.launch(share=True)"
      ],
