    {
      "cell_type": "code",
      "source": [
        "#chatbot ko chalan hai\n",
        "print(\"Please ask your question from me relevant to general knowledge\")\n",
        "\n",
        "# Redefining the chatbot function here with the correct best_score check\n",
        "def chatbot(user_question):\n",
        "  #user k given question ko numbers mai cn=onvert krna hai\n",
        "  user_vector = vectorizer.transform([user_question])\n",
        "\n",
        "  #user k question or dataset k question ki similarity dhkeni hai\n",
        "  score = cosine_similarity(user_vector, questions_vector).flatten()\n",
        "\n",
        "  #best index wali value nikalni hai\n",
        "  best_index = score.argmax()\n",
        "\n",
        "  #best score ki base pr answer nikalna hai\n",
        "  best_score = score[best_index]\n",
        "\n",
        "  # FIX: Compare best_score instead of the score array\n",
        "  if best_score < 0.2:\n",
        "    return \"Sorry I do not know the relevant answer\"\n",
        "\n",
        "  return answers[best_index]\n",
        "\n",
        "while True:\n",
        "  user_question = input(\"You\\t\")\n",
        "\n",
        "  if user_question.lower() in [\"exit\",\"bye\", \"goodbye\", \"quit\"]:\n",
        "    print(\"good bye have a nice day\")\n",
        "    break\n",
        "\n",
        "  if not user_question:\n",
        "    print(\"Bot:\\t Please ask your next question\")\n",
        "    continue\n",
        "\n",
        "  response = chatbot(user_question)\n",
        "  print(\"Bot:\\t\", response)"
      ],
